{
  "name": "lolita-loja",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/fotos/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loja-db",
      "database_id": "2c8dff86-c953-436a-bb6e-13d4bdea9882"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "fotos-loja"
    }
  ]
}
